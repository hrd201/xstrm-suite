# local incremental refresh config may contain AList tokens
/config/incremental-strm.json
/config/runtime.yaml
/config/strm-sync.yaml
/config/cert/
!/config/cert/.gitkeep

# python
__pycache__/
*.pyc

# env
.env
.env.*

/config/*.previous
/config/*.lock
/config/*.tmp
/deploy/.htpasswd
/deploy/test-config/
/deploy/test-data/
/deploy/test-*/

/deploy/wheels/*.whl
/acme-tool/
/cert-manager/

.venv/

/nginx/conf.d/.htpasswd-xstrm-admin
