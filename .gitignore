# runtime
*.log
logs/
log/
cache/
embyCache/
*.bak
*.runtime
*.runtime.*
nginx-log/
nginx-cache/

# xstrm state
/data/*.json
/data/*.sqlite
/data/*.sqlite3
/data/scheduler.sqlite3*
/data/scheduler.owner
/data/tasks/
/data/identity/
