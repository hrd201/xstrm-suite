[Unit]
Description=XSTRM Admin API
After=network.target

[Service]
Type=simple
User=xstrm
Group=xstrm
SupplementaryGroups=docker
WorkingDirectory=/opt/xstrm-suite
Environment="PATH=/opt/xstrm-suite/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/xstrm-suite/.venv/bin/python3 /opt/xstrm-suite/scripts/admin_api.py
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/xstrm-suite /emby-strm /mnt

[Install]
WantedBy=multi-user.target
