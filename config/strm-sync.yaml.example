output_root: /emby-strm
state_file: /opt/xstrm-suite/data/strm-sync-state.json
mode: mirror
strm_mode: logical_path
alist:
  base_url: http://127.0.0.1:5244
  token: YOUR_ALIST_TOKEN
  public_url: http://127.0.0.1:5244
emby:
  host: http://127.0.0.1:8096
  api_key: YOUR_EMBY_API_KEY
playback:
  backend: emby2alist
scan:
  incremental_only: true
  subtitle_sync: true
  include_ext:
    - .mp4
    - .mkv
    - .avi
    - .ts
    - .m2ts
# 在管理中心“定时任务”中创建，配置保存后自动生效。
scheduled_tasks: []
sources:
  - scan_mode: alist
    scan_path: /mnt/cloud/movies
    output_prefix: /mnt/cloud/movies
    library_type: movie
  - scan_mode: alist
    scan_path: /mnt/cloud/series
    output_prefix: /mnt/cloud/series
    library_type: series
emby2alist:
  media_mount_path:
    - /mnt/cloud
incremental_refresh:
  enabled: true
  state_db: /opt/xstrm-suite/data/incremental-strm.sqlite3
  max_dirs_per_run: 20
  target_max_dirs_per_run: 50
  request_interval_seconds: 3
  jitter_seconds: 10
  active_dir_ttl_days: 21
  recheck_active_after_hours: 6
  cold_dir_recheck_days: 7
  cold_dirs_per_run: 4
  retry_after_minutes: 30
  max_retry_attempts: 3
  remote_delete_policy: keep
  remote_delete_grace_days: 7
