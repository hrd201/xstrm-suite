project:
  name: xstrm-suite
  install_root: /opt/xstrm-suite
emby:
  host: http://127.0.0.1:8096
  api_key: YOUR_EMBY_API_KEY
alist:
  scheme: http
  host: 127.0.0.1
  port: 5244
  token: YOUR_ALIST_TOKEN
  public_addr: http://127.0.0.1:5244
  sign_enable: false
  sign_expire_time: 12
nginx:
  server_name: _
  http_port: 8091
  https_enabled: false
  https_port: 8095
  ssl_cert: /etc/nginx/cert/fullchain.pem
  ssl_key: /etc/nginx/cert/privkey.pem
  backend_scheme: http
  backend_port: 18095
mount:
  media_mount_path:
    - /mnt
xstrm:
  output_root: /emby-strm
  mode: mirror
  incremental_only: true
  sources: []
