proxy_pass $xstrm_mediawarp;
proxy_http_version 1.1;
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $xstrm_upgrade;
proxy_set_header Range $http_range;
proxy_set_header If-Range $http_if_range;
# MediaWarp uses the private OpenList address for APIs. Rewrite only its /d/
# redirect to the configured public download edge, preserving the signature.
proxy_redirect @@ALIST_DOWNLOAD_URL@@ @@PUBLIC_DOWNLOAD_URL@@;
proxy_buffering off;
proxy_read_timeout 300s;
