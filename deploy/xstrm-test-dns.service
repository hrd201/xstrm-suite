[Unit]
Description=DNS relay for isolated xstrm test containers
After=docker.service mihomo.service
Requires=docker.service

[Service]
Type=simple
User=nobody
ExecStart=/usr/bin/python3 /opt/xstrm-suite-test/deploy/dns_relay.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
